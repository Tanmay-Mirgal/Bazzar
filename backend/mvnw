# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup script
# ----------------------------------------------------------------------------

# If JAVA_HOME is not set, try to find it
if [ -z "$JAVA_HOME" ]; then
  if command -v java > /dev/null 2>&1; then
    JAVA_HOME=$(java -XshowSettings:all -version 2>&1 | grep "java.home" | awk '{print $3}')
  fi
fi

MAVEN_OPTS="${MAVEN_OPTS}"
MAVEN_WRAPPER_JAR=".mvn/wrapper/maven-wrapper.jar"
MAVEN_WRAPPER_PROPERTIES=".mvn/wrapper/maven-wrapper.properties"

# Read properties
DISTRIBUTION_URL=""
if [ -f "$MAVEN_WRAPPER_PROPERTIES" ]; then
  DISTRIBUTION_URL=$(grep "distributionUrl" "$MAVEN_WRAPPER_PROPERTIES" | cut -d'=' -f2-)
fi

exec "$JAVA_HOME/bin/java" $MAVEN_OPTS -jar "$MAVEN_WRAPPER_JAR" "$@"
